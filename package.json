  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop --outDir dist-desktop",
    "desktop:dev": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "desktop:build": "node node_modules/@tauri-apps/cli/tauri.js build --bundles nsis",
    "desktop:release": "powershell.exe -NoProfile -File scripts/build-windows-release.ps1",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@tauri-apps/api": "2.12.1",
