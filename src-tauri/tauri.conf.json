{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameMind Studio",
  "version": "0.1.1",
  "identifier": "cz.framemind.studio",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --strictPort",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameMind Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "theme": "Dark",
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "credentialless"
      },
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost blob: data: https://huggingface.co https://*.huggingface.co https://*.hf.co https://generativelanguage.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lukáš Drštička",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Czech", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "customLanguageFiles": { "Czech": "Czech.nsh" },
        "startMenuFolder": "FrameMind Studio"
      }
    }
  }
}
